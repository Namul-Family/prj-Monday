{
  "name": "@monday-bookmark/api",
  "version": "1.0.0",
  "description": "Backend API for monday-bookmark-service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "@prisma/client": "^5.3.1",
    "@monday-bookmark/types": "workspace:*",
    "@monday-bookmark/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/morgan": "^1.9.4",
    "typescript": "^5.2.2",
    "tsx": "^3.12.10",
    "nodemon": "^3.0.1",
    "prisma": "^5.3.1",
    "@monday-bookmark/tsconfig": "workspace:*",
    "@monday-bookmark/eslint-config": "workspace:*"
  }
}
