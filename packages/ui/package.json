{
    "name": "@monday-bookmark/ui",
    "version": "1.0.0",
    "description": "Shared UI components for monday-bookmark-service",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "files": ["dist"],
    "scripts": {
      "build": "tsc",
      "dev": "tsc --watch",
      "clean": "rm -rf dist",
      "lint": "eslint src",
      "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
      "react": ">=18.0.0",
      "react-dom": ">=18.0.0"
    },
    "devDependencies": {
      "@types/react": "^18.2.22",
      "@types/react-dom": "^18.2.7",
      "typescript": "^5.2.2",
      "@monday-bookmark/tsconfig": "workspace:*",
      "@monday-bookmark/eslint-config": "workspace:*"
    },
    "dependencies": {
      "lucide-react": "^0.279.0",
      "clsx": "^2.0.0"
    }
  }