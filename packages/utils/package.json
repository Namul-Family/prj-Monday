{
    "name": "@monday-bookmark/utils",
    "version": "1.0.0",
    "description": "Shared utility functions for monday-bookmark-service",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
